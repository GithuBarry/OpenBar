{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "lib/**/*.d.ts",
    "mcp/**/*.ts",
    "cloudflare/**/*.ts",
    "worker-configuration.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-home-review/types/**/*.ts",
    ".next-home-review/dev/types/**/*.ts",
    ".next-workbench-release/types/**/*.ts",
    ".next-workbench-release/dev/types/**/*.ts",
    ".next-todo-release/types/**/*.ts",
    ".next-todo-release/dev/types/**/*.ts",
    ".next-final-ui-review/types/**/*.ts",
    ".next-final-ui-review/dev/types/**/*.ts",
    ".next-map-recovery-check/types/**/*.ts",
    ".next-map-recovery-check/dev/types/**/*.ts",
    ".next-final-update/types/**/*.ts",
    ".next-final-update/dev/types/**/*.ts",
    ".next-ui-polish-review/types/**/*.ts",
    ".next-ui-polish-review/dev/types/**/*.ts",
    ".next-ui-polish-release/types/**/*.ts",
    ".next-ui-polish-release/dev/types/**/*.ts",
    ".next-ui-polish-final/types/**/*.ts",
    ".next-ui-polish-final/dev/types/**/*.ts",
    ".next-recovered-release/types/**/*.ts",
    ".next-recovered-release/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch",
    "content"
  ]
}
