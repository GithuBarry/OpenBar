{
  "name": "openbar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx scripts/openbar.ts doctor --all",
    "openbar": "tsx scripts/openbar.ts",
    "smoke": "tsx scripts/smoke-frontend.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "smoke:demo-state": "tsx scripts/smoke-demo-state.ts",
    "check:domain": "tsx scripts/check-research-invariants.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "docker:build": "docker build --platform linux/amd64 -f deploy/openbar.Dockerfile -t openbar-demo:local .",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "clean:all-generated": "rm -rf .next node_modules tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@citation-js/plugin-csl": "0.8.2",
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@unified-latex/unified-latex-to-hast": "1.8.4",
    "@unified-latex/unified-latex-types": "^1.8.0",
    "@unified-latex/unified-latex-util-match": "^1.8.0",
    "@unified-latex/unified-latex-util-parse": "^1.8.0",
    "@unified-latex/unified-latex-util-visit": "^1.8.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "d3-hierarchy": "3.1.2",
    "dompurify": "3.4.14",
    "file-type": "22.0.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "8.0.4",
    "hast-util-to-jsx-runtime": "2.3.6",
    "jose": "6.2.10",
    "katex": "^0.16.47",
    "lucide-react": "^0.469.0",
    "mdast-util-from-markdown": "^2.0.3",
    "next": "16.3.3",
    "pdfjs-dist": "^6.3.289",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "unified": "^10.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.128.0"
  }
}
